# StudySync Environment Configuration Example

# Desmos API Key
# Note: Vite environment variables prefixed with VITE_ are bundled into client-side code and visible in browser requests.
# It is strongly recommended to restrict your API key to approved development and production domains within your Desmos account settings.
VITE_DESMOS_API_KEY=

# Routine OCR adapter. Leave endpoint empty to use the safe frontend mock.
# This URL is public client configuration; never place model-server credentials here.
VITE_ROUTINE_OCR_ENDPOINT=
VITE_ROUTINE_OCR_MOCK=true
VITE_ROUTINE_OCR_MAX_FILE_MB=15
VITE_ROUTINE_OCR_TIMEOUT_MS=120000

# CUET Result Portal URL (Optional Override)
# CUET_PORTAL_URL=https://course.cuet.ac.bd/result_published.php
